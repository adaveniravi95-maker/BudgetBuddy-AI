# Backend (Render) - copy to backend/.env for local development
# Generate a real key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DATABASE_URL=sqlite:///./db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend (Vercel) - copy to frontend/.env for local development
# Leave empty locally so Vite's dev proxy handles /api -> http://localhost:8000
VITE_API_URL=